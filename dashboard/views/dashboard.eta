<%~ includeFile("partials/header.eta", {
	user: user
}); %>
<%~ includeFile("partials/message.eta"); %>
<%~ includeFile("partials/title.eta", {
	icon: "fas fa-cog",
	title: "Dashboard"
}); %>

<style>
  .table>:not(caption)>*>* {
    padding: 0.5rem 0.5rem;
  }
</style>

<div class="container">

  <div class="d-flex flex-wrap align-items-center justify-content-between mb-2">
    <h3 class="mb-0"><i class="fas fa-comments text-primary me-2"></i>Managed Groups & Conversations</h3>
    <% if (it.isBotAdmin) { %>
      <span class="badge bg-phoenix-primary p-2 fs--1"><i class="fas fa-shield-halved me-1"></i>Bot Administrator (All Threads Access)</span>
    <% } %>
  </div>

  <div class="d-sm-flex d-block align-items-center my-3">
    <div class="search-box me-2 flex-grow-1">
      <input class="form-control search-input search" type="search" placeholder="Search by Thread ID or Thread Name..." aria-label="Search" id="search-input">
      <span class="fas fa-search search-box-icon" aria-hidden="true"></span>
    </div>
    <div class="d-flex">
      <select class="form-select w-auto me-2 mt-2 mt-sm-0" id="searchBy" aria-label="Search By">
        <option value="thread_id" selected="selected">Thread ID</option>
        <option value="thread_name">Thread Name</option>
      </select>
      <button class="btn btn-phoenix-primary text-nowrap mt-2 mt-sm-0" id="reset-button">
        <i class="fas fa-sync"></i>
        Reset
      </button>
    </div>
  </div>

  <div data-list="" class="table-responsive" id="table-threads">
    <table class="table table-bordered table-striped align-middle">
      <thead>
        <tr>
          <th style="width: 50px;">#</th>
          <th class="sort" data-sort="thread_id">Thread ID</th>
          <th class="sort" data-sort="thread_name">Thread Name</th>
          <th class="sort" data-sort="members">Active Members</th>
          <th style="width: 100px;">Settings</th>
        </tr>
      </thead>

      <tbody class="list">
        <% if (threads.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center text-muted py-4">
            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-50"></i>
            No managed conversations found. Add the bot to your Messenger group or verify your Facebook ID.
          </td>
        </tr>
        <% } %>
        <% for (let i=0; i < threads.length; i++) { %>
        <tr>
          <td class="ps-2">
            <%= i + 1 %>
          </td>
          <td class="thread_id fw-semibold">
            <%= threads[i].threadID %>
          </td>
          <td class="thread_name">
            <%= threads[i].threadName || (threads[i].isGroup === false ? "Direct Message" : `Group ${threads[i].threadID}`) %>
          </td>
          <td class="members">
            <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= threads[i].members.filter(m=> m.inGroup).length %> members</span>
          </td>
          <td>
            <a href='/dashboard/<%=threads[i].threadID %>' class='btn btn-sm btn-phoenix-primary' title="Manage Settings">
              <i class="fa-solid fa-wrench me-1"></i> Configure
            </a>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
    <ul class="pagination"></ul>
  </div>

  <script>
    const options = {
      valueNames: ["thread_id", "thread_name", "members"],
      page: 10,
      pagination: true
    };

    const listThread = new List("table-threads", options);

    const resetButton = $("#reset-button");
    const searchInput = $("#search-input");
    const searchBy = $("#searchBy");

    $("#search-input, #searchBy").on("keyup change paste", function(e) {
      const searchValue = searchInput.val();
      const searchByValue = searchBy.val();
      if (searchByValue)
        listThread.search(searchValue, [searchByValue]);
      else
        listThread.search();
    });

    resetButton.on("click", function(e) {
      searchInput.val("");
      listThread.search();
    });
  </script>

  <%~ includeFile("partials/footer.eta") %>