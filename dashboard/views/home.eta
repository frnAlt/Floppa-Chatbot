<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Floppa-Chatbot | Web Analytics & Real-Time Dashboard</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg-primary: #07090e;
			--bg-card: rgba(15, 20, 32, 0.88);
			--bg-card-hover: rgba(22, 29, 46, 0.95);
			--border-card: rgba(255, 255, 255, 0.08);
			--border-card-highlight: rgba(0, 242, 254, 0.25);
			--accent-purple: #8a2be2;
			--accent-cyan: #00f2fe;
			--accent-pink: #ff007f;
			--accent-green: #10b981;
			--accent-amber: #f59e0b;
			--text-primary: #f8fafc;
			--text-secondary: #94a3b8;
			--text-muted: #64748b;
		}

		* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }

		body {
			background-color: var(--bg-primary);
			background-image: 
				radial-gradient(at 0% 0%, rgba(138, 43, 226, 0.18) 0px, transparent 50%),
				radial-gradient(at 100% 100%, rgba(0, 242, 254, 0.15) 0px, transparent 50%);
			background-attachment: fixed;
			color: var(--text-primary);
			min-height: 100vh;
			padding: 24px;
		}

		.container { max-width: 1440px; margin: 0 auto; }

		header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 20px 28px;
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 20px;
			backdrop-filter: blur(16px);
			margin-bottom: 22px;
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
			flex-wrap: wrap;
			gap: 16px;
		}

		.brand { display: flex; align-items: center; gap: 16px; }

		.brand-logo {
			width: 50px;
			height: 50px;
			border-radius: 14px;
			background: linear-gradient(135deg, var(--accent-purple), var(--accent-cyan));
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 26px;
			box-shadow: 0 0 20px rgba(138, 43, 226, 0.5);
			flex-shrink: 0;
		}

		.brand-info h1 {
			font-size: 22px;
			font-weight: 700;
			background: linear-gradient(90deg, #ffffff, #cbd5e1);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			letter-spacing: -0.5px;
		}

		.brand-info p { font-size: 13px; color: var(--text-secondary); margin-top: 3px; }

		.header-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

		.badge-env {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			background: rgba(138, 43, 226, 0.15);
			border: 1px solid rgba(138, 43, 226, 0.35);
			color: #d8b4fe;
			padding: 7px 14px;
			border-radius: 24px;
			font-size: 12px;
			font-weight: 600;
		}

		.status-badge {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			background: rgba(16, 185, 129, 0.12);
			border: 1px solid rgba(16, 185, 129, 0.3);
			color: var(--accent-green);
			padding: 8px 16px;
			border-radius: 24px;
			font-size: 13px;
			font-weight: 600;
		}

		.pulse-dot {
			width: 8px;
			height: 8px;
			background-color: var(--accent-green);
			border-radius: 50%;
			box-shadow: 0 0 10px var(--accent-green);
			animation: pulse 1.6s infinite;
		}

		@keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.3; transform: scale(0.85); } 100% { opacity: 1; transform: scale(1); } }

		/* NAV TABS */
		.nav-tabs-bar {
			display: flex;
			gap: 8px;
			margin-bottom: 22px;
			background: var(--bg-card);
			padding: 8px;
			border-radius: 16px;
			border: 1px solid var(--border-card);
			overflow-x: auto;
		}

		.tab-btn {
			background: transparent;
			border: none;
			color: var(--text-secondary);
			padding: 10px 18px;
			border-radius: 10px;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			transition: all 0.2s ease;
			white-space: nowrap;
		}

		.tab-btn:hover {
			color: var(--text-primary);
			background: rgba(255, 255, 255, 0.05);
		}

		.tab-btn.active {
			background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(0, 242, 254, 0.25));
			color: #ffffff;
			border: 1px solid rgba(0, 242, 254, 0.4);
			box-shadow: 0 4px 16px rgba(0, 242, 254, 0.15);
		}

		.tab-content { display: none; }
		.tab-content.active { display: block; animation: fadeIn 0.25s ease; }

		@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

		/* STAT CARDS */
		.grid-stats {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
			gap: 18px;
			margin-bottom: 22px;
		}

		.card {
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 18px;
			padding: 20px;
			backdrop-filter: blur(16px);
			transition: all 0.2s ease;
		}

		.card:hover {
			transform: translateY(-2px);
			border-color: var(--border-card-highlight);
		}

		.card-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 12px;
			color: var(--text-secondary);
			font-size: 13px;
			font-weight: 500;
		}

		.card-header i { font-size: 18px; color: var(--accent-cyan); }

		.card-value { font-size: 26px; font-weight: 700; margin-bottom: 4px; letter-spacing: -0.5px; }

		.card-subtext { font-size: 12px; color: var(--text-muted); }

		/* TELEMETRY CHART */
		.chart-card {
			margin-bottom: 22px;
		}

		.section-title {
			font-size: 17px;
			font-weight: 600;
			margin-bottom: 16px;
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		.section-title-left {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.section-title i { color: var(--accent-cyan); }

		.chart-container {
			background: rgba(6, 8, 14, 0.75);
			border: 1px solid var(--border-card);
			border-radius: 14px;
			padding: 16px;
			height: 190px;
			position: relative;
		}

		canvas#telemetryCanvas { width: 100%; height: 100%; }

		/* SEARCH BAR */
		.search-container {
			display: flex;
			gap: 12px;
			margin-bottom: 16px;
			flex-wrap: wrap;
		}

		.search-input-wrapper {
			position: relative;
			flex-grow: 1;
			min-width: 240px;
		}

		.search-input-wrapper i {
			position: absolute;
			left: 14px;
			top: 50%;
			transform: translateY(-50%);
			color: var(--text-muted);
			font-size: 14px;
		}

		.search-input {
			width: 100%;
			background: rgba(6, 8, 14, 0.7);
			border: 1px solid var(--border-card);
			color: var(--text-primary);
			padding: 10px 14px 10px 38px;
			border-radius: 12px;
			font-size: 13px;
			outline: none;
			transition: border-color 0.2s;
		}

		.search-input:focus {
			border-color: var(--accent-cyan);
		}

		/* TABLES */
		.table-responsive {
			overflow-x: auto;
			border-radius: 14px;
			border: 1px solid var(--border-card);
			background: rgba(6, 8, 14, 0.5);
		}

		table.data-table {
			width: 100%;
			border-collapse: collapse;
			text-align: left;
			font-size: 13px;
		}

		table.data-table th {
			background: rgba(15, 20, 32, 0.95);
			padding: 14px 16px;
			color: var(--text-secondary);
			font-weight: 600;
			border-bottom: 1px solid var(--border-card);
			text-transform: uppercase;
			font-size: 11px;
			letter-spacing: 0.5px;
		}

		table.data-table td {
			padding: 14px 16px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.04);
			color: var(--text-primary);
			vertical-align: middle;
		}

		table.data-table tr:hover td {
			background: rgba(255, 255, 255, 0.02);
		}

		.table-badge {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 4px 10px;
			border-radius: 14px;
			font-size: 11px;
			font-weight: 600;
		}

		.badge-cyan { background: rgba(0, 242, 254, 0.12); color: var(--accent-cyan); }
		.badge-purple { background: rgba(138, 43, 226, 0.15); color: #d8b4fe; }
		.badge-green { background: rgba(16, 185, 129, 0.12); color: var(--accent-green); }
		.badge-amber { background: rgba(245, 158, 11, 0.12); color: var(--accent-amber); }

		.action-link {
			color: var(--accent-cyan);
			text-decoration: none;
			font-weight: 600;
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 6px 12px;
			border-radius: 8px;
			background: rgba(0, 242, 254, 0.08);
			border: 1px solid rgba(0, 242, 254, 0.2);
			transition: all 0.2s ease;
		}

		.action-link:hover {
			background: rgba(0, 242, 254, 0.2);
			border-color: var(--accent-cyan);
			transform: translateY(-1px);
		}

		/* CHAT LOGS */
		.log-container {
			background: #04060a;
			border: 1px solid var(--border-card);
			border-radius: 14px;
			height: 520px;
			overflow-y: auto;
			padding: 16px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 12.5px;
		}

		.log-entry {
			padding: 8px 10px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.04);
			display: flex;
			gap: 12px;
			align-items: baseline;
			line-height: 1.5;
		}

		.log-time { color: #64748b; font-size: 11px; flex-shrink: 0; }
		.log-thread { color: #38bdf8; font-weight: 500; flex-shrink: 0; }
		.log-sender { color: #fbbf24; font-weight: 600; flex-shrink: 0; }
		.log-body { color: #e2e8f0; word-break: break-all; }

		/* CONTROLS */
		.btn-control {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid var(--border-card);
			color: var(--text-primary);
			padding: 10px 18px;
			border-radius: 12px;
			font-size: 13px;
			font-weight: 600;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			transition: all 0.2s ease;
		}

		.btn-control:hover {
			background: rgba(138, 43, 226, 0.25);
			border-color: var(--accent-purple);
			transform: translateY(-2px);
		}

		.control-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 20px;
		}

		.control-box {
			background: rgba(6, 8, 14, 0.7);
			border: 1px solid var(--border-card);
			border-radius: 16px;
			padding: 22px;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			gap: 16px;
		}

		.control-box-header h4 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
		.control-box-header p { font-size: 12.5px; color: var(--text-secondary); line-height: 1.4; }

		footer {
			margin-top: 35px;
			text-align: center;
			color: var(--text-secondary);
			font-size: 13px;
			padding: 20px;
			border-top: 1px solid var(--border-card);
		}
	</style>
</head>
<body>

<div class="container">
	<header>
		<div class="brand">
			<div class="brand-logo">🐱</div>
			<div class="brand-info">
				<h1>Floppa-Chatbot Web Analytics</h1>
				<p>Architect: frnAlt (Gtajisan / Farhan Muh Tasim) • Native FCA API Engine</p>
			</div>
		</div>

		<div class="header-actions">
			<div class="badge-env" id="badgeEnv">
				<i class="fa-solid fa-cloud"></i>
				<span id="badgeEnvText">Detecting Host...</span>
			</div>
			<div class="status-badge">
				<div class="pulse-dot"></div>
				<span id="botStatusText">Online 24/7</span>
			</div>
		</div>
	</header>

	<!-- TAB NAVIGATION -->
	<div class="nav-tabs-bar">
		<button class="tab-btn active" onclick="switchTab('tab-overview', this)">
			<i class="fa-solid fa-chart-line"></i> Overview & Telemetry
		</button>
		<button class="tab-btn" onclick="switchTab('tab-threads', this)">
			<i class="fa-solid fa-layer-group"></i> Groups & Conversations (<span id="tabCountThreads">0</span>)
		</button>
		<button class="tab-btn" onclick="switchTab('tab-users', this)">
			<i class="fa-solid fa-users"></i> Users & Economy (<span id="tabCountUsers">0</span>)
		</button>
		<button class="tab-btn" onclick="switchTab('tab-logs', this)">
			<i class="fa-solid fa-terminal"></i> Live Chat Logs
		</button>
		<button class="tab-btn" onclick="switchTab('tab-controls', this)">
			<i class="fa-solid fa-sliders"></i> Operations Console
		</button>
	</div>

	<!-- TAB 1: OVERVIEW & TELEMETRY -->
	<div id="tab-overview" class="tab-content active">
		<div class="grid-stats">
			<div class="card">
				<div class="card-header">
					<span>System Uptime</span>
					<i class="fa-solid fa-stopwatch"></i>
				</div>
				<div class="card-value" id="valUptime">--</div>
				<div class="card-subtext">Continuous Runtime</div>
			</div>

			<div class="card">
				<div class="card-header">
					<span>Heap Memory</span>
					<i class="fa-solid fa-memory"></i>
				</div>
				<div class="card-value" id="valRam">-- MB</div>
				<div class="card-subtext" id="valRamSub">Allocated: -- MB</div>
			</div>

			<div class="card">
				<div class="card-header">
					<span>Conversations</span>
					<i class="fa-solid fa-comments"></i>
				</div>
				<div class="card-value" id="valThreads">--</div>
				<div class="card-subtext">Active Threads & DMs</div>
			</div>

			<div class="card">
				<div class="card-header">
					<span>Total Users</span>
					<i class="fa-solid fa-users"></i>
				</div>
				<div class="card-value" id="valUsers">--</div>
				<div class="card-subtext">Registered in Database</div>
			</div>

			<div class="card">
				<div class="card-header">
					<span>Commands</span>
					<i class="fa-solid fa-cube"></i>
				</div>
				<div class="card-value" id="valCmds">125</div>
				<div class="card-subtext">Diagnostic Verified</div>
			</div>
		</div>

		<div class="card chart-card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-microchip"></i>
					<span>Real-Time CPU Load Curve</span>
				</div>
				<span class="table-badge badge-cyan" id="valCpuPercent">Load: --%</span>
			</div>
			<div class="chart-container">
				<canvas id="telemetryCanvas"></canvas>
			</div>
		</div>

		<div class="card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-server"></i>
					<span>Environment & Host Telemetry</span>
				</div>
			</div>
			<div class="control-grid">
				<div class="control-box">
					<div class="control-box-header">
						<h4>Deployment Environment</h4>
						<p id="envDetailText">Render Cloud / Linux VPS</p>
					</div>
					<div class="card-subtext" id="renderUrlText">No external URL configured</div>
				</div>
				<div class="control-box">
					<div class="control-box-header">
						<h4>Engine & API Core</h4>
						<p id="fcaEngineText">Native Floppa FCA Engine</p>
					</div>
					<div class="card-subtext" id="nodeVersionText">Node.js --</div>
				</div>
				<div class="control-box">
					<div class="control-box-header">
						<h4>System Hardware</h4>
						<p id="sysHardwareText">Cores: -- • System RAM: -- GB</p>
					</div>
					<div class="card-subtext" id="platformText">Platform: --</div>
				</div>
			</div>
		</div>
	</div>

	<!-- TAB 2: GROUPS & THREADS -->
	<div id="tab-threads" class="tab-content">
		<div class="card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-comments"></i>
					<span>Messenger Groups & Conversations Directory</span>
				</div>
				<span class="table-badge badge-purple" id="threadsCountBadge">0 Total</span>
			</div>

			<div class="search-container">
				<div class="search-input-wrapper">
					<i class="fa-solid fa-magnifying-glass"></i>
					<input type="text" id="threadsSearch" class="search-input" placeholder="Search by Thread Name or Thread ID..." oninput="filterThreads()">
				</div>
			</div>

			<div class="table-responsive">
				<table class="data-table" id="threadsTable">
					<thead>
						<tr>
							<th style="width: 60px;">#</th>
							<th>Thread ID</th>
							<th>Conversation Name</th>
							<th>Members</th>
							<th>Admins</th>
							<th>Mode</th>
							<th>Settings</th>
						</tr>
					</thead>
					<tbody id="threadsTableBody">
						<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">Loading conversations...</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- TAB 3: USERS & ECONOMY -->
	<div id="tab-users" class="tab-content">
		<div class="card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-users"></i>
					<span>User Directory & Economy Rankings</span>
				</div>
				<span class="table-badge badge-green" id="usersCountBadge">0 Total</span>
			</div>

			<div class="search-container">
				<div class="search-input-wrapper">
					<i class="fa-solid fa-magnifying-glass"></i>
					<input type="text" id="usersSearch" class="search-input" placeholder="Search by Facebook UID or User Name..." oninput="filterUsers()">
				</div>
			</div>

			<div class="table-responsive">
				<table class="data-table" id="usersTable">
					<thead>
						<tr>
							<th style="width: 60px;">#</th>
							<th>User ID (UID)</th>
							<th>Name</th>
							<th>Balance ($)</th>
							<th>Level</th>
							<th>EXP</th>
							<th>Role</th>
						</tr>
					</thead>
					<tbody id="usersTableBody">
						<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">Loading users...</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- TAB 4: CHAT LOGS -->
	<div id="tab-logs" class="tab-content">
		<div class="card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-terminal"></i>
					<span>Real-Time Messenger Message Stream</span>
				</div>
				<button class="btn-control" style="padding: 6px 14px; font-size: 12px;" onclick="toggleLogPause()" id="btnLogPause">
					<i class="fa-solid fa-pause"></i> Pause Stream
				</button>
			</div>
			<div class="log-container" id="logContainer">
				<div style="color: var(--text-muted); text-align: center; padding: 40px;">Connecting to live message stream...</div>
			</div>
		</div>
	</div>

	<!-- TAB 5: OPERATIONS CONSOLE -->
	<div id="tab-controls" class="tab-content">
		<div class="card">
			<div class="section-title">
				<div class="section-title-left">
					<i class="fa-solid fa-sliders"></i>
					<span>Bot Operations & Maintenance Console</span>
				</div>
			</div>

			<div class="control-grid">
				<div class="control-box">
					<div class="control-box-header">
						<h4>Hot-Reload Commands</h4>
						<p>Re-evaluate and hot-reload all command scripts without restarting the bot process or dropping Messenger MQTT connections.</p>
					</div>
					<button class="btn-control" onclick="reloadCommands()"><i class="fa-solid fa-arrows-rotate"></i> Reload All Commands</button>
				</div>

				<div class="control-box">
					<div class="control-box-header">
						<h4>Memory Flush & GC</h4>
						<p>Purge command execution caches, temporary image buffers, and trigger Node.js V8 garbage collection.</p>
					</div>
					<button class="btn-control" onclick="clearCache()"><i class="fa-solid fa-broom"></i> Flush System Cache</button>
				</div>

				<div class="control-box">
					<div class="control-box-header">
						<h4>Toggle Bot Mode</h4>
						<p>Switch between Public Online mode (handles all messages) and Admin-Only Maintenance mode.</p>
					</div>
					<button class="btn-control" onclick="toggleBotMode()"><i class="fa-solid fa-power-off"></i> Toggle Mode</button>
				</div>

				<div class="control-box">
					<div class="control-box-header">
						<h4>Health Probe</h4>
						<p>Verify HTTP 200 health check response for Render Cloud / UptimeRobot liveness probes.</p>
					</div>
					<button class="btn-control" onclick="testHealth()"><i class="fa-solid fa-heart-pulse"></i> Test Liveness (<span id="healthPing">-- ms</span>)</button>
				</div>
			</div>
		</div>
	</div>

	<footer>
		Floppa-Chatbot Platform • Real-Time Web Analytics Management • Architect: frnAlt (Gtajisan / Farhan Muh Tasim)
	</footer>
</div>

<script>
const telemetryHistory = Array(30).fill(20);
let cachedThreads = [];
let cachedUsers = [];
let isLogPaused = false;

function switchTab(tabId, el) {
	document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
	document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
	document.getElementById(tabId).classList.add('active');
	el.classList.add('active');

	if (tabId === 'tab-overview') {
		setTimeout(drawTelemetryChart, 50);
	}
}

function drawTelemetryChart() {
	const canvas = document.getElementById('telemetryCanvas');
	if (!canvas) return;
	const ctx = canvas.getContext('2d');
	const width = canvas.width = canvas.parentElement.clientWidth;
	const height = canvas.height = canvas.parentElement.clientHeight;

	ctx.clearRect(0, 0, width, height);

	// Grid Lines
	ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
	ctx.lineWidth = 1;
	for (let y = 0; y < height; y += 30) {
		ctx.beginPath();
		ctx.moveTo(0, y);
		ctx.lineTo(width, y);
		ctx.stroke();
	}

	// Curve
	ctx.beginPath();
	const step = width / (telemetryHistory.length - 1);
	telemetryHistory.forEach((val, i) => {
		const x = i * step;
		const y = height - (val / 100 * height);
		if (i === 0) ctx.moveTo(x, y);
		else ctx.lineTo(x, y);
	});

	ctx.strokeStyle = '#00f2fe';
	ctx.lineWidth = 2.5;
	ctx.stroke();

	// Fill Area
	ctx.lineTo(width, height);
	ctx.lineTo(0, height);
	ctx.closePath();
	const gradient = ctx.createLinearGradient(0, 0, 0, height);
	gradient.addColorStop(0, 'rgba(0, 242, 254, 0.22)');
	gradient.addColorStop(1, 'rgba(0, 242, 254, 0.0)');
	ctx.fillStyle = gradient;
	ctx.fill();
}

async function updateDashboard() {
	try {
		const res = await fetch('/api/bot-info');
		const data = await res.json();
		if (data.status === 'success') {
			document.getElementById('valUptime').innerText = data.uptimeFormatted || '--';
			document.getElementById('valRam').innerText = `${data.memoryUsedMB} MB`;
			document.getElementById('valRamSub').innerText = `Allocated: ${data.memoryTotalMB} MB`;
			document.getElementById('valThreads').innerText = data.totalThreads || 0;
			document.getElementById('valUsers').innerText = data.totalUsers || 0;
			document.getElementById('valCmds').innerText = data.totalCommands || 125;
			document.getElementById('tabCountThreads').innerText = data.totalThreads || 0;
			document.getElementById('tabCountUsers').innerText = data.totalUsers || 0;

			// Environment badge
			const badge = document.getElementById('badgeEnv');
			const badgeText = document.getElementById('badgeEnvText');
			if (data.isVercel) {
				badgeText.innerText = "Vercel Cloud";
				badge.style.borderColor = "rgba(255, 255, 255, 0.4)";
				badge.style.color = "#ffffff";
			} else if (data.isRender) {
				badgeText.innerText = "Render Cloud";
				badge.style.borderColor = "rgba(0, 242, 254, 0.4)";
				badge.style.color = "#00f2fe";
			} else {
				badgeText.innerText = data.environment || "Local Engine";
			}

			// Host telemetry
			document.getElementById('envDetailText').innerText = `${data.environment} • Prefix: "${data.prefix}"`;
			if (data.renderUrl) {
				document.getElementById('renderUrlText').innerHTML = `<a href="${data.renderUrl}" target="_blank" style="color: var(--accent-cyan);">${data.renderUrl}</a>`;
			} else {
				document.getElementById('renderUrlText').innerText = `Bot Mode: ${data.botMode}`;
			}
			document.getElementById('fcaEngineText').innerText = data.fcaEngine || "Native Floppa FCA Engine";
			document.getElementById('nodeVersionText').innerText = `Node.js: ${data.nodeVersion}`;
			document.getElementById('sysHardwareText').innerText = `Cores: ${data.cpuCores} • Sys RAM: ${data.systemRamUsedGB} / ${data.systemRamTotalGB} GB`;
			document.getElementById('platformText').innerText = `Platform: ${data.platform}`;

			document.getElementById('botStatusText').innerText = data.botMode || "Online 24/7";

			const cpuPct = Math.min(100, Math.max(10, Math.round((parseFloat(data.cpuLoad) || 0.15) * 45)));
			document.getElementById('valCpuPercent').innerText = `Load: ${cpuPct}%`;
			telemetryHistory.push(cpuPct);
			telemetryHistory.shift();
			drawTelemetryChart();
		}

		if (!isLogPaused) {
			const logRes = await fetch('/api/chat-logs');
			const logData = await logRes.json();
			if (logData.status === 'success' && Array.isArray(logData.logs)) {
				const container = document.getElementById('logContainer');
				if (logData.logs.length === 0) {
					container.innerHTML = `<div style="color: var(--text-muted); text-align: center; padding: 40px;">No incoming messages logged yet. Send a message to Floppa-Chatbot!</div>`;
				} else {
					container.innerHTML = logData.logs.map(log => `
						<div class="log-entry">
							<span class="log-time">[${log.timestamp || ''}]</span>
							<span class="log-thread">[${log.isGroup === false ? 'DM' : (log.threadName || `Group ${log.threadID}`)}]</span>
							<span class="log-sender">${log.senderName || log.senderID}:</span>
							<span class="log-body">${escapeHtml(log.body || '')}</span>
						</div>
					`).join('');
				}
			}
		}

	} catch (e) {
		console.error("Dashboard update error:", e);
	}
}

async function loadThreadsList() {
	try {
		const res = await fetch('/api/threads-list');
		const data = await res.json();
		if (data.status === 'success' && Array.isArray(data.threads)) {
			cachedThreads = data.threads;
			renderThreadsTable(cachedThreads);
		}
	} catch (e) {
		console.error("Failed to load threads list:", e);
	}
}

function renderThreadsTable(threads) {
	const tbody = document.getElementById('threadsTableBody');
	document.getElementById('threadsCountBadge').innerText = `${threads.length} Listed`;

	if (threads.length === 0) {
		tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">No conversations match your search query.</td></tr>`;
		return;
	}

	tbody.innerHTML = threads.map((t, index) => `
		<tr>
			<td style="color: var(--text-muted);">${index + 1}</td>
			<td style="font-family: 'JetBrains Mono', monospace; font-weight: 600;">${t.threadID}</td>
			<td style="font-weight: 600;">${escapeHtml(t.threadName || 'Group ' + t.threadID)}</td>
			<td><span class="table-badge badge-cyan">${t.membersCount} members</span></td>
			<td><span class="table-badge badge-purple">${t.adminCount} admins</span></td>
			<td><span class="table-badge ${t.approvalMode ? 'badge-amber' : 'badge-green'}">${t.approvalMode ? 'Approval Req' : 'Open'}</span></td>
			<td>
				<a href="/dashboard/${t.threadID}" class="action-link" title="Open Settings">
					<i class="fa-solid fa-gear"></i> Configure
				</a>
			</td>
		</tr>
	`).join('');
}

function filterThreads() {
	const query = document.getElementById('threadsSearch').value.toLowerCase().trim();
	if (!query) {
		renderThreadsTable(cachedThreads);
		return;
	}
	const filtered = cachedThreads.filter(t => 
		String(t.threadID).includes(query) || 
		String(t.threadName || '').toLowerCase().includes(query)
	);
	renderThreadsTable(filtered);
}

async function loadUsersList() {
	try {
		const res = await fetch('/api/users-list');
		const data = await res.json();
		if (data.status === 'success' && Array.isArray(data.users)) {
			cachedUsers = data.users;
			renderUsersTable(cachedUsers);
		}
	} catch (e) {
		console.error("Failed to load users list:", e);
	}
}

function renderUsersTable(users) {
	const tbody = document.getElementById('usersTableBody');
	document.getElementById('usersCountBadge').innerText = `${users.length} Listed`;

	if (users.length === 0) {
		tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 30px;">No users match your search query.</td></tr>`;
		return;
	}

	tbody.innerHTML = users.map((u, index) => `
		<tr>
			<td style="color: var(--text-muted);">${index + 1}</td>
			<td style="font-family: 'JetBrains Mono', monospace; font-weight: 600;">${u.userID}</td>
			<td style="font-weight: 600;">${escapeHtml(u.name || 'Facebook User')}</td>
			<td style="color: #34d399; font-weight: 600;">$${Number(u.money || 0).toLocaleString()}</td>
			<td><span class="table-badge badge-cyan">Level ${u.level || 1}</span></td>
			<td style="color: var(--text-secondary);">${Number(u.exp || 0).toLocaleString()} XP</td>
			<td>
				<span class="table-badge ${u.isAdmin ? 'badge-purple' : 'badge-green'}">
					<i class="fa-solid ${u.isAdmin ? 'fa-shield-halved' : 'fa-user'}"></i>
					${u.role}
				</span>
			</td>
		</tr>
	`).join('');
}

function filterUsers() {
	const query = document.getElementById('usersSearch').value.toLowerCase().trim();
	if (!query) {
		renderUsersTable(cachedUsers);
		return;
	}
	const filtered = cachedUsers.filter(u => 
		String(u.userID).includes(query) || 
		String(u.name || '').toLowerCase().includes(query)
	);
	renderUsersTable(filtered);
}

function toggleLogPause() {
	isLogPaused = !isLogPaused;
	const btn = document.getElementById('btnLogPause');
	if (isLogPaused) {
		btn.innerHTML = `<i class="fa-solid fa-play"></i> Resume Stream`;
		btn.style.borderColor = "var(--accent-green)";
		btn.style.color = "var(--accent-green)";
	} else {
		btn.innerHTML = `<i class="fa-solid fa-pause"></i> Pause Stream`;
		btn.style.borderColor = "var(--border-card)";
		btn.style.color = "var(--text-primary)";
	}
}

async function reloadCommands() {
	try {
		const res = await fetch('/api/control/reload-commands', { method: 'POST' });
		const data = await res.json();
		alert(data.message || "Commands reloaded successfully!");
		updateDashboard();
	} catch (e) {
		alert("Failed to reload commands: " + e.message);
	}
}

async function clearCache() {
	try {
		const res = await fetch('/api/control/clear-cache', { method: 'POST' });
		const data = await res.json();
		alert(data.message || "Cache cleared cleanly!");
		updateDashboard();
	} catch (e) {
		alert("Failed to clear cache: " + e.message);
	}
}

async function toggleBotMode() {
	try {
		const res = await fetch('/api/control/toggle-bot-mode', { method: 'POST' });
		const data = await res.json();
		alert(data.message || "Bot mode toggled!");
		updateDashboard();
	} catch (e) {
		alert("Failed to toggle bot mode: " + e.message);
	}
}

async function testHealth() {
	const start = Date.now();
	try {
		const res = await fetch('/health');
		const latency = Date.now() - start;
		const el = document.getElementById('healthPing');
		el.innerText = `${latency} ms (HTTP ${res.status})`;
		el.style.color = res.ok ? "var(--accent-green)" : "var(--accent-pink)";
	} catch (e) {
		document.getElementById('healthPing').innerText = "Failed";
	}
}

function escapeHtml(str) {
	return String(str)
		.replace(/&/g, "&amp;")
		.replace(/</g, "&lt;")
		.replace(/>/g, "&gt;")
		.replace(/"/g, "&quot;")
		.replace(/'/g, "&#039;");
}

window.addEventListener('resize', drawTelemetryChart);

// Initialize
updateDashboard();
loadThreadsList();
loadUsersList();
testHealth();
setInterval(updateDashboard, 2500);
</script>

</body>
</html>