<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Floppa-Chatbot | Web Analytics & Real-Time Dashboard</title>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg-primary: #07090e;
			--bg-card: rgba(15, 20, 32, 0.85);
			--border-card: rgba(255, 255, 255, 0.08);
			--accent-purple: #8a2be2;
			--accent-cyan: #00f2fe;
			--accent-pink: #ff007f;
			--accent-green: #10b981;
			--text-primary: #f8fafc;
			--text-secondary: #94a3b8;
		}

		* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Outfit', sans-serif; }

		body {
			background-color: var(--bg-primary);
			background-image: 
				radial-gradient(at 0% 0%, rgba(138, 43, 226, 0.18) 0px, transparent 50%),
				radial-gradient(at 100% 100%, rgba(0, 242, 254, 0.15) 0px, transparent 50%);
			color: var(--text-primary);
			min-height: 100vh;
			padding: 24px;
		}

		.container { max-width: 1400px; margin: 0 auto; }

		header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 22px 28px;
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 20px;
			backdrop-filter: blur(16px);
			margin-bottom: 25px;
			box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
		}

		.brand { display: flex; align-items: center; gap: 18px; }

		.brand-logo {
			width: 52px;
			height: 52px;
			border-radius: 14px;
			background: linear-gradient(135deg, var(--accent-purple), var(--accent-cyan));
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 28px;
			box-shadow: 0 0 20px rgba(138, 43, 226, 0.5);
		}

		.brand-info h1 {
			font-size: 24px;
			font-weight: 700;
			background: linear-gradient(90deg, #ffffff, #cbd5e1);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		.brand-info p { font-size: 13px; color: var(--text-secondary); margin-top: 2px; }

		.status-group { display: flex; align-items: center; gap: 15px; }

		.status-badge {
			display: flex;
			align-items: center;
			gap: 10px;
			background: rgba(16, 185, 129, 0.12);
			border: 1px solid rgba(16, 185, 129, 0.3);
			color: var(--accent-green);
			padding: 10px 20px;
			border-radius: 30px;
			font-size: 14px;
			font-weight: 600;
		}

		.pulse-dot {
			width: 9px;
			height: 9px;
			background-color: var(--accent-green);
			border-radius: 50%;
			box-shadow: 0 0 12px var(--accent-green);
			animation: pulse 1.5s infinite;
		}

		@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

		.btn-control {
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid var(--border-card);
			color: var(--text-primary);
			padding: 10px 18px;
			border-radius: 12px;
			font-size: 13px;
			font-weight: 600;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			transition: all 0.2s ease;
		}

		.btn-control:hover {
			background: rgba(138, 43, 226, 0.25);
			border-color: var(--accent-purple);
			transform: translateY(-2px);
		}

		.grid-stats {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 20px;
			margin-bottom: 25px;
		}

		.card {
			background: var(--bg-card);
			border: 1px solid var(--border-card);
			border-radius: 18px;
			padding: 22px;
			backdrop-filter: blur(16px);
			transition: all 0.2s ease;
		}

		.card:hover {
			transform: translateY(-3px);
			border-color: rgba(255, 255, 255, 0.18);
		}

		.card-header {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-bottom: 14px;
			color: var(--text-secondary);
			font-size: 14px;
		}

		.card-header i { font-size: 20px; color: var(--accent-cyan); }

		.card-value { font-size: 28px; font-weight: 700; margin-bottom: 6px; }

		.card-subtext { font-size: 12px; color: var(--text-secondary); }

		.main-grid {
			display: grid;
			grid-template-columns: 2fr 1fr;
			gap: 25px;
		}

		@media (max-width: 950px) { .main-grid { grid-template-columns: 1fr; } }

		.section-title {
			font-size: 18px;
			font-weight: 600;
			margin-bottom: 18px;
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.section-title i { color: var(--accent-pink); }

		.chart-container {
			background: rgba(6, 8, 14, 0.7);
			border: 1px solid var(--border-card);
			border-radius: 14px;
			padding: 15px;
			height: 180px;
			margin-bottom: 20px;
			position: relative;
		}

		canvas#telemetryChart { width: 100%; height: 100%; }

		.log-container {
			background: #05070a;
			border: 1px solid var(--border-card);
			border-radius: 14px;
			height: 380px;
			overflow-y: auto;
			padding: 16px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 13px;
		}

		.log-entry {
			padding: 10px;
			border-bottom: 1px solid rgba(255, 255, 255, 0.04);
			display: flex;
			gap: 12px;
		}

		.log-time { color: #64748b; font-size: 11px; }
		.log-sender { color: #38bdf8; font-weight: 600; }
		.log-body { color: #e2e8f0; word-break: break-all; }

		.threads-list { max-height: 580px; overflow-y: auto; }

		.thread-item {
			background: rgba(255, 255, 255, 0.02);
			border: 1px solid var(--border-card);
			border-radius: 12px;
			padding: 14px 16px;
			margin-bottom: 12px;
			display: flex;
			justify-content: space-between;
			align-items: center;
		}

		.thread-name { font-weight: 600; font-size: 14px; }
		.thread-id { font-size: 12px; color: var(--text-secondary); margin-top: 2px; }
		.thread-members {
			background: rgba(0, 242, 254, 0.1);
			color: var(--accent-cyan);
			padding: 4px 12px;
			border-radius: 14px;
			font-size: 12px;
			font-weight: 600;
		}

		footer {
			margin-top: 35px;
			text-align: center;
			color: var(--text-secondary);
			font-size: 13px;
			padding: 18px;
		}
	</style>
</head>
<body>

<div class="container">
	<header>
		<div class="brand">
			<div class="brand-logo">🐱</div>
			<div class="brand-info">
				<h1>Floppa-Chatbot Web Analytics</h1>
				<p>Developer: Gtajisan (Farhan Muh Tasim) • Native FCA API v5 Engine</p>
			</div>
		</div>
		<div class="status-group">
			<button class="btn-control" onclick="reloadCommands()"><i class="fa-solid fa-arrows-rotate"></i> Reload Cmds</button>
			<button class="btn-control" onclick="clearCache()"><i class="fa-solid fa-broom"></i> Clear Cache</button>
			<div class="status-badge">
				<div class="pulse-dot"></div>
				<span id="botStatusText">Online 24/7</span>
			</div>
		</div>
	</header>

	<div class="grid-stats">
		<div class="card">
			<div class="card-header">
				<span>System Uptime</span>
				<i class="fa-solid fa-stopwatch"></i>
			</div>
			<div class="card-value" id="valUptime">--</div>
			<div class="card-subtext">24/7 Continuous Mode</div>
		</div>

		<div class="card">
			<div class="card-header">
				<span>Heap RAM Memory</span>
				<i class="fa-solid fa-memory"></i>
			</div>
			<div class="card-value" id="valRam">-- MB</div>
			<div class="card-subtext" id="valRamSub">Garbage Collector active</div>
		</div>

		<div class="card">
			<div class="card-header">
				<span>Active Threads</span>
				<i class="fa-solid fa-comments"></i>
			</div>
			<div class="card-value" id="valThreads">--</div>
			<div class="card-subtext">Messenger Groups & DMs</div>
		</div>

		<div class="card">
			<div class="card-header">
				<span>Total Bot Users</span>
				<i class="fa-solid fa-users"></i>
			</div>
			<div class="card-value" id="valUsers">--</div>
			<div class="card-subtext">Registered user database</div>
		</div>

		<div class="card">
			<div class="card-header">
				<span>Loaded Commands</span>
				<i class="fa-solid fa-cube"></i>
			</div>
			<div class="card-value" id="valCmds">125</div>
			<div class="card-subtext">100% Diagnostic Verified</div>
		</div>
	</div>

	<div class="main-grid">
		<div>
			<div class="card" style="margin-bottom: 25px;">
				<div class="section-title">
					<i class="fa-solid fa-chart-line"></i>
					<span>Real-Time Telemetry & CPU Load Chart</span>
				</div>
				<div class="chart-container">
					<canvas id="telemetryCanvas"></canvas>
				</div>
			</div>

			<div class="card">
				<div class="section-title">
					<i class="fa-solid fa-terminal"></i>
					<span>Live Messenger Chat Log Stream</span>
				</div>
				<div class="log-container" id="logContainer">
					<div style="color: #64748b; text-align: center; padding: 20px;">Connecting to live chat stream...</div>
				</div>
			</div>
		</div>

		<div class="card">
			<div class="section-title">
				<i class="fa-solid fa-layer-group"></i>
				<span>Active Messenger Conversations</span>
			</div>
			<div class="threads-list" id="threadsList">
				<div style="color: #64748b; text-align: center; padding: 20px;">Loading conversation data...</div>
			</div>
		</div>
	</div>

	<footer>
		Floppa-Chatbot Platform • Real-Time Web Analytics Management • Developed by Gtajisan (Farhan Muh Tasim)
	</footer>
</div>

<script>
const telemetryHistory = Array(30).fill(20);

function drawTelemetryChart() {
	const canvas = document.getElementById('telemetryCanvas');
	if (!canvas) return;
	const ctx = canvas.getContext('2d');
	const width = canvas.width = canvas.parentElement.clientWidth;
	const height = canvas.height = canvas.parentElement.clientHeight;

	ctx.clearRect(0, 0, width, height);

	// Draw Grid Lines
	ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
	ctx.lineWidth = 1;
	for (let y = 0; y < height; y += 30) {
		ctx.beginPath();
		ctx.moveTo(0, y);
		ctx.lineTo(width, y);
		ctx.stroke();
	}

	// Draw Curve
	ctx.beginPath();
	const step = width / (telemetryHistory.length - 1);
	telemetryHistory.forEach((val, i) => {
		const x = i * step;
		const y = height - (val / 100 * height);
		if (i === 0) ctx.moveTo(x, y);
		else ctx.lineTo(x, y);
	});

	ctx.strokeStyle = '#00f2fe';
	ctx.lineWidth = 3;
	ctx.stroke();

	// Fill Area
	ctx.lineTo(width, height);
	ctx.lineTo(0, height);
	ctx.closePath();
	const gradient = ctx.createLinearGradient(0, 0, 0, height);
	gradient.addColorStop(0, 'rgba(0, 242, 254, 0.25)');
	gradient.addColorStop(1, 'rgba(0, 242, 254, 0.0)');
	ctx.fillStyle = gradient;
	ctx.fill();
}

async function updateDashboard() {
	try {
		const res = await fetch('/api/bot-info');
		const data = await res.json();
		if (data.status === 'success') {
			document.getElementById('valUptime').innerText = data.uptimeFormatted || '--';
			document.getElementById('valRam').innerText = `${data.memoryUsedMB} MB`;
			document.getElementById('valRamSub').innerText = `Allocated: ${data.memoryTotalMB} MB`;
			document.getElementById('valThreads').innerText = data.totalThreads || 0;
			document.getElementById('valUsers').innerText = data.totalUsers || 0;
			document.getElementById('valCmds').innerText = data.totalCommands || 125;

			const cpuPct = Math.min(100, Math.max(10, Math.round((data.cpuLoad || 0.15) * 40)));
			telemetryHistory.push(cpuPct);
			telemetryHistory.shift();
			drawTelemetryChart();
		}

		const logRes = await fetch('/api/chat-logs');
		const logData = await logRes.json();
		if (logData.status === 'success' && Array.isArray(logData.logs)) {
			const container = document.getElementById('logContainer');
			if (logData.logs.length === 0) {
				container.innerHTML = `<div style="color: #64748b; text-align: center; padding: 20px;">No incoming messages logged yet. Send a message to Floppa-Chatbot!</div>`;
			} else {
				container.innerHTML = logData.logs.map(log => `
					<div class="log-entry">
						<span class="log-time">[${log.timestamp || ''}]</span>
						<span class="log-sender">${log.senderID}:</span>
						<span class="log-body">${log.body}</span>
					</div>
				`).join('');
			}
		}

		const threadRes = await fetch('/api/threads-list');
		const threadData = await threadRes.json();
		if (threadData.status === 'success' && Array.isArray(threadData.threads)) {
			const list = document.getElementById('threadsList');
			list.innerHTML = threadData.threads.map(t => `
				<div class="thread-item">
					<div>
						<div class="thread-name">${t.threadName}</div>
						<div class="thread-id">ID: ${t.threadID}</div>
					</div>
					<div class="thread-members">${t.membersCount} members</div>
				</div>
			`).join('');
		}

	} catch (e) {
		console.error("Dashboard update error:", e);
	}
}

async function reloadCommands() {
	try {
		const res = await fetch('/api/control/reload-commands', { method: 'POST' });
		const data = await res.json();
		alert(data.message || "Commands reloaded successfully!");
		updateDashboard();
	} catch (e) {
		alert("Failed to reload commands: " + e.message);
	}
}

async function clearCache() {
	try {
		const res = await fetch('/api/control/clear-cache', { method: 'POST' });
		const data = await res.json();
		alert(data.message || "Cache cleared successfully!");
		updateDashboard();
	} catch (e) {
		alert("Failed to clear cache: " + e.message);
	}
}

window.addEventListener('resize', drawTelemetryChart);
updateDashboard();
setInterval(updateDashboard, 2500);
</script>

</body>
</html>